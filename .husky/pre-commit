#!/usr/bin/env sh
set -eu

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm not found in PATH." >&2
  exit 1
fi

sh scripts/check/check-git-identity.sh
pnpm exec lint-staged --no-stash
node scripts/quality/gate-manifest.mjs
node scripts/check/check-docs-sync.mjs
pnpm run check:any-budget:t11
node scripts/check/check-tracked-artifacts.mjs